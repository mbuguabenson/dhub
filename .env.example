# ==========================================
# dtraderHub Environment Template
# ==========================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Deriv OAuth2 Client ID
# Obtain from https://developers.deriv.com
OAUTH_CLIENT_ID=your_oauth_client_id_here

# Translations CDN URL (optional, leave empty for local)
TRANSLATIONS_CDN_URL=

# Release / Branch reference name (optional)
REF_NAME=main
